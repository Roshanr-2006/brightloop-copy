# Copy this file to .env (never commit .env)
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
DB_FILE=./data/brightloop.db

# First admin account created by `npm run db:reset`
ADMIN_NAME=Brightloop Admin
ADMIN_EMAIL=admin@brightloop.test
ADMIN_PASSWORD=Admin@12345

# Email (optional). Without SMTP_HOST, mails are logged and saved in data/outbox/
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Brightloop <no-reply@brightloop.test>
